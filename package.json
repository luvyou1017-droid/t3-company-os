{
  "name": "t3-company-os",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test:campaign-creation": "node --experimental-strip-types --experimental-specifier-resolution=node scripts/runCampaignCreationV2.mjs",
    "test:campaign-drafts": "node --experimental-strip-types --experimental-specifier-resolution=node scripts/runCampaignDrafts.mjs",
    "test:campaign-defaults": "node --experimental-strip-types --experimental-specifier-resolution=node scripts/runCampaignDefaults.mjs",
    "test:settlement-document": "node --experimental-strip-types --experimental-specifier-resolution=node scripts/runSettlementDocument.mjs",
    "test:settlement-payout": "node --experimental-strip-types --experimental-specifier-resolution=node scripts/runSettlementPayoutFlow.mjs",
    "test:wise-settlement-fixture": "node --experimental-strip-types --experimental-specifier-resolution=node scripts/runWiseVendorSettlementFixture.mjs",
    "test:scenarios": "node --experimental-strip-types --experimental-specifier-resolution=node scripts/runOperationalScenarios.mjs",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.110.8",
    "html-to-image": "^1.11.13",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^10.6.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.62.0",
    "vite": "^8.1.1"
  }
}
